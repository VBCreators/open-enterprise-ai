# ==============================================================================
# Open Enterprise AI - Environment Configuration Template
# Copy this file to .env or .env.<APP_ENV> and customize for your environment.
# Never commit real secrets or production credentials to source control.
# ==============================================================================

# Application Environment: local, development, test, staging, production
# NOTE: APP_ENV must be set in your OS environment to select the .env.<APP_ENV> file.
APP_ENV=local

# Debug mode: true or false (must be false in production)
DEBUG=false

# Application name identifier
APP_NAME=open-enterprise-ai

# Application host binding address (use 127.0.0.1 for local, 0.0.0.0 inside containers)
APP_HOST=127.0.0.1

# Application port number (1-65535)
APP_PORT=8000

# Logging severity level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Application secret key for cryptographic tokens (dummy placeholder; change in deployment)
SECRET_KEY=change-this-insecure-dev-secret-to-a-secure-random-value
